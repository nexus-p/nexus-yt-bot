# Telegram
TELEGRAM_BOT_TOKEN=

# AI / Transcription
GROQ_API_KEY=

# YouTube
YOUTUBE_API_KEY=

# Admin
ADMIN_USER_IDS=

# Optional
LOG_LEVEL=info

# Cache (extraction) — set CACHE_TTL_SECONDS=0 to disable
CACHE_TTL_SECONDS=3600

# Rate Limiter (bot-core) — set RATE_LIMIT_MAX_REQUESTS=0 to disable
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
